{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knightfall-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "triggers": {
    "crons": [
      "17 3,11,19 * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "450fd1881c2dc4d660af851490191bc3",
    "PASSWORD_RESET_FROM": "Knightfall <accounts@ash-fall.com>"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knightfall-forum",
      "database_id": "c64617c2-ac78-44ba-b107-a17e10638a57",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "dd5b7be732cc4a4585aed60a9980b0b3"
    }
  ],
  "ratelimits": [
    {
      "name": "MESSAGE_RATE_LIMITER",
      "namespace_id": "65017",
      "simple": {"limit": 60, "period": 60}
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {"name":"MESSAGE_LIVE","class_name":"MessageLiveRoom"},
      {"name":"IMP_INFERNO_ROOMS","class_name":"ImpInfernoRoom"}
    ]
  },
  "migrations": [
    {"tag":"v1-message-live","new_sqlite_classes":["MessageLiveRoom"]},
    {"tag":"v2-imp-inferno-rooms","new_sqlite_classes":["ImpInfernoRoom"]}
  ],
  "r2_buckets": [
    {
      "binding": "VAULT",
      "bucket_name": "knightfall-personal-admin-vault"
    },
    {
      "binding": "PUBLIC_ASSETS",
      "bucket_name": "knightfall-public-game-assets"
    },
    {
      "binding": "MESSAGE_ATTACHMENTS",
      "bucket_name": "knightfall-message-attachments"
    },
    {
      "binding": "PROFILE_MEDIA",
      "bucket_name": "knightfall-profile-media"
    },
    {
      "binding": "CREATOR_MEDIA",
      "bucket_name": "knightfall-creator-private-media"
    }
  ]
}
