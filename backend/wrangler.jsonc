{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knightfall-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-05",
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knightfall-forum",
      "database_id": "c64617c2-ac78-44ba-b107-a17e10638a57",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "dd5b7be732cc4a4585aed60a9980b0b3"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
